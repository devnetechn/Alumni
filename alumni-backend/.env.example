DATABASE_URL=postgres://postgres:123@localhost:8000/alumni
TEST_DATABASE_URL=postgres://postgres:123@localhost:8000/alumni_test
JWT_SECRET=change-me-in-production
PORT=4000
APP_DATABASE_URL=postgres://alumni_app:alumni_app_dev@localhost:8000/alumni
TEST_APP_DATABASE_URL=postgres://alumni_app:alumni_app_dev@localhost:8000/alumni_test
PLATFORM_DATABASE_URL=postgres://alumni_platform:alumni_platform_dev@localhost:8000/alumni
TEST_PLATFORM_DATABASE_URL=postgres://alumni_platform:alumni_platform_dev@localhost:8000/alumni_test
# Optional — without these the AI support bot in Messages replies with a
# fixed "not configured" message instead of calling OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
