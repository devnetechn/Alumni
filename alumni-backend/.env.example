DATABASE_URL=postgres://postgres:123@localhost:8000/alumni
TEST_DATABASE_URL=postgres://postgres:123@localhost:8000/alumni_test
JWT_SECRET=change-me-in-production
PORT=4000
# Dev-only: which school to serve when a request's Host header has no
# recognizable subdomain (e.g. plain http://localhost:5173). Ignored in
# production.
DEFAULT_SCHOOL_SLUG=
# Production single-tenant fallback: which school to serve when a request's
# Host header has no recognizable subdomain (e.g. a bare Vercel URL with no
# custom domain). Unlike DEFAULT_SCHOOL_SLUG, this is allowed in production —
# it always resolves to exactly this one school, never from request data, so
# it's safe as long as you only have one school on this deployment. Drop it
# once you add per-school subdomains for a second school.
SINGLE_TENANT_SLUG=
# Where PayMongo should redirect the browser after checkout (success/cancel
# URLs for /signup-checkout and /renew-checkout). Required whenever the
# frontend and backend are on different origins (e.g. Vercel + Render) --
# req.headers.host is the backend's own host in that setup, not the
# frontend's. Leave unset for local dev, where Vite's proxy makes them the
# same origin already.
FRONTEND_URL=
APP_DATABASE_URL=postgres://alumni_app:alumni_app_dev@localhost:8000/alumni
TEST_APP_DATABASE_URL=postgres://alumni_app:alumni_app_dev@localhost:8000/alumni_test
PLATFORM_DATABASE_URL=postgres://alumni_platform:alumni_platform_dev@localhost:8000/alumni
TEST_PLATFORM_DATABASE_URL=postgres://alumni_platform:alumni_platform_dev@localhost:8000/alumni_test
# Optional — without these the AI support bot in Messages replies with a
# fixed "not configured" message instead of calling OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required for the registration-fee payment feature. Test-mode keys work
# without a fully verified PayMongo business account.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Generated in PayMongo Dashboard > Developers > Webhooks after registering
# the /api/payments/webhook endpoint (Task 6).
PAYMONGO_WEBHOOK_SECRET=
